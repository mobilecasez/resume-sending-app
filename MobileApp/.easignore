# Old build artifacts - these inflate the upload
*.ipa
*.apk
*.aab

# JS dependencies — EAS Build reinstalls them in the cloud
node_modules/

# Build output folders
build/
dist/
.expo/
web-build/

# Android build artifacts (regenerated by Gradle in the cloud)
android/build/
android/.gradle/
android/.kotlin/
android/app/build/
android/app/.cxx/

# iOS build artifacts (regenerated by pod install / xcodebuild in the cloud)
ios/build/
ios/Pods/
ios/DerivedData/

# Design assets not needed for the build
Claude Designs/

# Fastlane metadata/screenshots (not needed for build)
fastlane/screenshots/
fastlane/metadata/

# Logs
*.log
expo.log

# OS files
.DS_Store
