        last_name: "Samadhiya",
        email_address: "zsellr.in@gmail.com",
        phone_number: "+919970020596",
        demo_user: "cvapplyrtest@gmail.com",
        demo_password: "test!123",
        notes: "To test the app:\n1. Log in with the demo credentials above (use 'Log In with Email' option, not Google/Apple)\n2. The app generates AI-powered cover letters for job applications\n3. Upload a resume PDF from the profile section\n4. Enter a company name and job description to generate a cover letter\n5. Review the generated cover letter and send the application via email\n\nThe app requires an internet connection to function."
      }
    )
  end

  desc "Set app category and age rating"
  lane :set_category do
    deliver(
