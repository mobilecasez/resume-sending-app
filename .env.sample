# Copy this file to .env and fill in your details
# cp .env.sample .env

# ========================================
# REQUIRED: Email Configuration
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ========================================
# REQUIRED: File Paths
# ========================================
RESUME_PATH=
COVER_LETTER_PATH=Cover_Letter_Rishi_Samadhiya.pdf

# ========================================
# For Each Application - Update These
# ========================================
COMPANY_NAME=
POSITION=
RECIPIENT_EMAIL=
RECIPIENT_NAME=Hiring Manager

# Why are you interested in THIS specific company? (1-2 sentences)
COMPANY_PARAGRAPH=

# What skills are most relevant for THIS job?
RELEVANT_SKILLS=

# ========================================
# Optional - Your Contact Info
# (Update these in index.js contactInfo array)
# ========================================
YOUR_EMAIL=
YOUR_PHONE=
YOUR_LINKEDIN=
YOUR_PORTFOLIO=

# ========================================
# Optional Settings
# ========================================
KEEP_GENERATED_FILES=false
EMAIL_SUBJECT=
