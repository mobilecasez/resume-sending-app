# ========================================
# Resume Sending App - Configuration
# ========================================

# Server Configuration
PORT=3000

# Security Keys - CHANGE THESE IN PRODUCTION!
# Generate strong random keys for security (minimum 32 characters each)
JWT_SECRET=your-secret-key-change-this-in-production-use-minimum-32-characters
ENCRYPTION_KEY=your-encryption-key-change-this-in-production-use-minimum-32-characters

# To generate secure keys, run in terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ========================================
# AI Cover Letter Generation (Optional)
# ========================================

# OpenAI API Key for AI-powered cover letters
# Get your API key from: https://platform.openai.com/api-keys
# If not set, the app will use smart template-based generation
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Without OpenAI, the app still generates excellent cover letters by:
# - Automatically parsing your resume
# - Scraping company websites
# - Matching skills with company needs  
# - Creating natural, human-sounding content with variety

# ========================================
# Optional Settings
# ========================================

# Keep generated cover letter files (true) or delete them after sending (false)
KEEP_GENERATED_FILES=false
